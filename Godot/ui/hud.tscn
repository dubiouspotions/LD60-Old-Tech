[node name="IntroText" type="Label" parent="Root/Intro/Center/Card/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(490, 0)
layout_mode = 2
text = "The column marches east on its own. It halts at anything it can't cross: walls over 1 m, drops over 3 m, water, spikes. You are the engineers above the field. Dig, fill, bridge and blast a way through before the towers thin the ranks."
autowrap_mode = 3

[node name="Rules" type="RichTextLabel" parent="Root/Intro/Center/Card/Rows"]
custom_minimum_size = Vector2(490, 0)
layout_mode = 2
theme_override_colors/default_color = Color(0.6039, 0.651, 0.7059, 1)
theme_override_font_sizes/normal_font_size = 13
theme_override_font_sizes/bold_font_size = 13
bbcode_enabled = true
text = "[ul][b]Dig[/b] soft earth (+1 earth), fell trees (trunk → logs, leaves → rope), mine cyan crystals (+1 powder). Dig a bridge member to take it back.
[b]Fill[/b] drops a block of earth that falls until it lands.
[b]Log[/b] and [b]Rope[/b]: drag from point to point. Ends snap to a 0.5 m grid and to existing joints. An end touching ground is bolted down. Joints are hinges, so build triangles or hang the deck from ropes. Logs take push and pull up to 5 m long; ropes only pull, up to 12 m. Members glow red as they near breaking, and each soldier adds 80 kg.
[b]Charge[/b] blasts rock, brick and bridges within 2.6 m, your own soldiers included.
Build while paused (Space), then resume to load the bridge. Pan with right-drag, the wheel, A/D, or the Pan tool. F toggles speed, C follows the column.[/ul]"
fit_content = true

