[gd_scene format=3]

[ext_resource type="Script" path="res://ui/pause_menu.gd" id="1_script"]
[ext_resource type="Resource" path="res://data/sounds/ui_click.tres" id="2_click"]
[ext_resource type="PackedScene" path="res://ui/settings_menu.tscn" id="3_settings"]

[sub_resource type="StyleBoxEmpty" id="no_panel"]

[node name="PauseMenu" type="ColorRect"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0588, 0.0824, 0.1137, 0.62)
script = ExtResource("1_script")
click_sound = ExtResource("2_click")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Card" type="PanelContainer" parent="Center"]
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Center/Card"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/Card/Rows"]
layout_mode = 2
theme_type_variation = &"Heading"
text = "Paused"
horizontal_alignment = 1

[node name="Buttons" type="VBoxContainer" parent="Center/Card/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="ResumeButton" type="Button" parent="Center/Card/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 22
text = "Resume"

[node name="RestartCheckpointButton" type="Button" parent="Center/Card/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 22
text = "Restart from Checkpoint"

[node name="RestartButton" type="Button" parent="Center/Card/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 22
text = "Restart"

[node name="SettingsButton" type="Button" parent="Center/Card/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 22
text = "Settings"

[node name="QuitButton" type="Button" parent="Center/Card/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 22
text = "Quit to Main Menu"

[node name="SettingsMenu" parent="Center/Card/Rows" instance=ExtResource("3_settings")]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_styles/panel = SubResource("no_panel")
